<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap mp">
  
  <Identity Name="adelka4745.Toolkit"
            Publisher="CN=adelka4745"
            Version="1.0.0.0" />
  
  <Properties>
    <DisplayName>adelka4745 Toolkit</DisplayName>
    <PublisherDisplayName>adelka4745</PublisherDisplayName>
    <Logo>images\StoreLogo.png</Logo>
  </Properties>
  
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="ru-ru" />
  </Resources>
  
  <Applications>
    <Application Id="App"
                 StartPage="ms-appx:///index.html">
      <uap:VisualElements DisplayName="adelka4745 Toolkit"
                          Square150x150Logo="images\Square150x150Logo.png"
                          Square44x44Logo="images\Square44x44Logo.png"
                          Description="HTML/CSS/JS application packaged as MSIX for Windows"
                          BackgroundColor="transparent">
        <uap:DefaultTile />
        <uap:SplashScreen Image="images\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
